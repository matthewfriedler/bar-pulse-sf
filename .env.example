# Copy this file to .env and fill in real values.
# Get these from your Supabase project settings.
#
# VITE_ prefixed vars are compiled into the browser bundle and are publicly
# visible by design. Only put values here that are safe for anyone to see.
# The Supabase publishable key is safe because Row Level Security governs
# what it can actually do.
#
# No map API key is needed: the map uses Leaflet with OpenStreetMap/CARTO
# tiles, and opening hours come from bars.opening_hours in the database.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
